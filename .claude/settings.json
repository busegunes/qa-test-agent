      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git cat-file:*)",
      "Bash(git status:*)",
      "Bash(npm run sync:*)",
      "Bash(npm run index:*)",
      "Bash(npm run check:*)",
      "Bash(npm run export:*)",
      "Bash(npm run refresh:*)",
      "Bash(npm run log:run:*)"
    ]
  }
}
